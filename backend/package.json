{
  "name": "subflow-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.js",
    "start": "tsx src/server.js",
    "typecheck": "tsc --noEmit",
    "demo:data": "tsx scripts/demo-data.ts",
    "db:setup": "tsx scripts/db-setup.ts",
    "payments:db": "tsx scripts/payments-db.ts",
    "payments:db:reset": "tsx scripts/payments-db.ts --reset",
    "payments:seed": "tsx src/payments/seed.ts",
    "payments:seed:large": "tsx src/payments/seed.ts --large",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jose": "^6.0.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.0",
    "tsx": "^4.19.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "~5.6.2",
    "vitest": "^2.1.0"
  }
}
