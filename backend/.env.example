PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payments & Analytics: direct Postgres connection (Supabase > Connect > Session pooler).
# Server-side only. Never expose in the frontend.
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
# Optional: real invoice emails, e.g. smtp://user:pass@sandbox.smtp.mailtrap.io:2525
SMTP_URL=
MAIL_FROM=billing@subflow.app
# Local development only. Must stay false/unset on any shared or deployed server.
DEV_AUTH=false
